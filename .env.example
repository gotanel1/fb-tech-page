# ===== Facebook =====
# ID ของเพจ (ตัวเลขล้วน) - หาได้จาก SETUP.md ขั้นตอนที่ 4
FB_PAGE_ID=

# Page Access Token แบบถาวร - หาได้จาก SETUP.md ขั้นตอนที่ 5
FB_PAGE_TOKEN=

# ===== Gemini =====
# API key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ===== พฤติกรรมของบอท =====
# จำนวนโพสต์ต่อการรัน 1 ครั้ง
POSTS_PER_RUN=1

# ข่าวต้องใหม่กว่ากี่ชั่วโมงถึงจะเอามาโพสต์
MAX_AGE_HOURS=36

# link  = โพสต์แนบลิงก์ตรง ๆ (มีรูป preview อัตโนมัติ)
# comment = โพสต์ข้อความล้วน แล้วเอาลิงก์ไปไว้คอมเมนต์แรก (reach ดีกว่า)
POST_STYLE=comment

# ตั้ง true เพื่อทดลองรันโดยไม่โพสต์จริง
DRY_RUN=false
